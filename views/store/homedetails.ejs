<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %></title>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Quicksand', sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f8f8f8;
    }

    .container {
      display: flex;
      gap: 20px;
      max-width: 1200px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .sidebar {
      width: 250px;
      background: white;
      border-radius: 12px;
      padding: 16px;
      height: 80vh;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    }

    .sidebar h3 {
      font-size: 1.2rem;
      color: #5c2dd5;
    }

    .details {
      flex: 1;
      background: white;
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    }

    .details img {
      width: 100%;
      height: 320px;
      object-fit: cover;
      border-radius: 8px;
      margin-bottom: 16px;
    }

    .info {
      margin-bottom: 10px;
      color: #555;
    }

    .info strong {
      color: #000;
    }

    .back-link {
      text-align: center;
      margin-top: 20px;
    }

    .back-link a {
      text-decoration: none;
      color: #5c2dd5;
      font-weight: bold;
    }

    .back-link a:hover {
      text-decoration: underline;
    }

    .fav-button {
      margin-top: 20px;
    }

    .fav-button button {
      padding: 10px 20px;
      background-color: #5c2dd5;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    .fav-button button:hover {
      background-color: #4a22b3;
    }
  </style>
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="container">
    <!-- Left Sidebar -->
    <div class="sidebar">
      <h3>More Homes</h3>
      <p><i>Home list will show here later...</i></p>
    </div>

    <!-- Right Details Pane -->
    <div class="details">
      <img src="<%= home.photo %>" alt="<%= home.houseName %>" onerror="this.src='/images/default.jpg'">
      <h2><%= home.houseName %></h2>
      <div class="info"><strong>Price:</strong> ₹ <%= home.price %></div>
      <div class="info"><strong>Location:</strong> <%= home.location %></div>
      <div class="info"><strong>Rating:</strong> ⭐ <%= home.rating %> / 5</div>
      <div class="info"><strong>Description:</strong> A cozy and peaceful home away from home.</div>

      <!-- Styled Add to Fav Button -->
      <div class="fav-button">
        <%- include('../partials/fav') %>
      </div>
    </div>
  </div>
</body>
</html>
