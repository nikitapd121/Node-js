<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= pageTitle %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --primary: #281094;
      --primary-dark: #1b075c;
      --bg-light: #f5f6fa;
      --card-bg: #ffffff;
      --text-dark: #2c2c2c;
      --shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
      --transition: 0.3s ease;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background: linear-gradient(to right, #e6e9f9, #f5f6fa);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    .container {
      max-width: 420px;
      margin: 100px auto;
      padding: 40px 30px;
      background-color: var(--card-bg);
      border-radius: 16px;
      box-shadow: var(--shadow);
      text-align: center;
      transition: transform var(--transition);
    }

    .container:hover {
      transform: translateY(-3px);
    }

    h1 {
      margin-bottom: 24px;
      color: var(--primary);
      font-size: 24px;
      font-weight: 600;
    }

    .error-messages {
      color: red;
      text-align: left;
      font-size: 14px;
      margin-bottom: 16px;
      list-style: none;
      padding-left: 0;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    input[type="email"],
    input[type="password"] {
      padding: 14px;
      border: 1px solid #ccc;
      border-radius: 10px;
      font-size: 15px;
      transition: border-color var(--transition), box-shadow var(--transition);
    }

    input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 2px rgba(40, 16, 148, 0.15);
      outline: none;
    }

    input::placeholder {
      color: #888;
    }

    button[type="submit"] {
      background-color: var(--primary);
      color: white;
      padding: 14px;
      border: none;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color var(--transition);
    }

    button[type="submit"]:hover {
      background-color: var(--primary-dark);
    }

    .or-text {
      margin: 20px 0 10px;
      color: #666;
      font-size: 14px;
    }

    .signup-btn {
      display: inline-block;
      padding: 12px;
      border-radius: 10px;
      background-color: #eee;
      color: var(--primary);
      text-decoration: none;
      font-weight: 500;
      transition: background-color var(--transition), color var(--transition);
    }

    .signup-btn:hover {
      background-color: var(--primary);
      color: #fff;
    }

    @media (max-width: 480px) {
      .container {
        margin: 60px 20px;
        padding: 32px 20px;
      }
    }
  </style>
</head>
<body>

  <%- include('../partials/nav') %>

  <div class="container">
    <h1>Login to Airbnb</h1>

    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <ul class="error-messages">
        <% errors.forEach(err => { %>
          <li><%= err.msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <form action="/login" method="POST">
      <input type="email" name="email" placeholder="📧 Enter your email"
        value="<%= typeof oldInput !== 'undefined' ? oldInput.email : '' %>" required />

      <input type="password" name="password" placeholder="🔒 Enter your password"
        value="<%= typeof oldInput !== 'undefined' ? oldInput.password : '' %>" required />

      <button type="submit">Login</button>
    </form>

    <div class="or-text">Don't have an account?</div>
    <a href="/signup" class="signup-btn">Sign Up</a>
  </div>

  <script>
    document.querySelector('form').addEventListener('submit', function (e) {
      const email = document.querySelector('input[name="email"]');
      const password = document.querySelector('input[name="password"]');

      let isValid = true;
      let emailPattern = /^[^ ]+@[^ ]+\.[a-z]{2,3}$/;

      email.style.borderColor = "#ccc";
      password.style.borderColor = "#ccc";

      if (!emailPattern.test(email.value)) {
        email.style.borderColor = "red";
        isValid = false;
      }

      if (password.value.length < 6) {
        password.style.borderColor = "red";
        isValid = false;
      }

      if (!isValid) {
        e.preventDefault();
        alert("Please enter a valid email and password with at least 6 characters.");
      }
    });
  </script>
</body>
</html>
