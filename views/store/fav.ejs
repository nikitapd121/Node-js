<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Your Favorite Homes | Airbnb</title>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #5c2dd5;
      --primary-dark: #3d1a99;
      --bg-light: #fafafa;
      --card-bg: #ffffff;
      --text-dark: #222;
      --text-muted: #666;
    }

    body {
      font-family: 'Quicksand', sans-serif;
      background-color: var(--bg-light);
      margin: 0;
      padding: 0;
      color: var(--text-dark);
    }

    header {
      background: linear-gradient(90deg, #5c2dd5, #7c4dff);
      color: white;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 40px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .title {
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: 1px;
    }

    .nav-btns {
      display: flex;
      gap: 12px;
    }

    .nav-btns a {
      background: white;
      color: var(--primary);
      padding: 10px 18px;
      text-decoration: none;
      font-weight: 600;
      border-radius: 10px;
      transition: 0.3s ease;
      border: none;
    }

    .nav-btns a:hover {
      background-color: #eee4ff;
    }

    main {
      padding: 50px 20px;
      max-width: 1200px;
      margin: 0 auto;
    }

    h2 {
      font-size: 2.2rem;
      text-align: center;
      margin-bottom: 0.4rem;
    }

    h3 {
      font-size: 1.2rem;
      text-align: center;
      color: var(--text-muted);
      margin-bottom: 2.5rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 28px;
    }

    .card {
      background: var(--card-bg);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      display: flex;
      flex-direction: column;
      transition: 0.3s ease;
    }

    .card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
    }

    .card img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-bottom: 1px solid #eee;
    }

    .card-body {
      padding: 20px;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .card-body h4 {
      font-size: 1.3rem;
      color: var(--primary-dark);
      margin-bottom: 12px;
    }

    .info {
      font-size: 0.95rem;
      margin-bottom: 8px;
      color: var(--text-muted);
    }

    .info strong {
      color: var(--text-dark);
    }

    .buttons {
      margin-top: 20px;
      display: flex;
      justify-content: space-between;
      gap: 10px;
    }

    .buttons button,
    .buttons form button {
      flex: 1;
      background: linear-gradient(135deg, #7b4dff, #5c2dd5);
      color: white;
      padding: 10px;
      font-size: 0.95rem;
      font-weight: 600;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .buttons button:hover,
    .buttons form button:hover {
      background: linear-gradient(135deg, #5c2dd5, #3d1a99);
      transform: scale(1.05);
      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.2);
    }

    @media (max-width: 600px) {
      .title {
        font-size: 1.6rem;
      }

      h2 {
        font-size: 1.6rem;
      }

      h3 {
        font-size: 1rem;
      }
    }
  </style>
</head>
<body>

  <%- include('../partials/nav') %>

  <main>
    <h2>Your Favorite Homes</h2>
    <h3>Handpicked just for you</h3>

    <div class="grid">
      <% registeredHomes.forEach((home) => { %>
        <% if (home) { %>
          <div class="card">
            <img src="<%= home.photo %>" alt="<%= home.houseName %> image" onerror="this.src='/images/default.jpg'" />
            <div class="card-body">
              <h4><%= home.houseName %></h4>
              <div class="info"><strong>Price:</strong> ₹ <%= home.price %></div>
              <div class="info"><strong>Location:</strong> <%= home.location %></div>
              <div class="info"><strong>Rating:</strong> ⭐ <%= home.rating %> / 5</div>
              <div class="buttons">
                <button class="book-btn" data-name="<%= home.houseName %>">Book</button>
                <form action="/delete-favhome/<%= home._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this home?');">
                  <button type="submit">Delete</button>
                </form>
              </div>
            </div>
          </div>
        <% } %>
      <% }) %>
    </div>

    <% if (registeredHomes.length === 0) { %>
      <p style="text-align: center; color: var(--text-muted); margin-top: 40px;">You haven't favorited any homes yet.</p>
    <% } %>
  </main>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll(".book-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          alert("Booking feature coming soon!");
        });
      });
    });
  </script>

</body>
</html>
